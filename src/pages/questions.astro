---
import { render } from 'astro:content';
import AskForm from '../components/AskForm.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getQuestions } from '../lib/content';
import { SITE } from '../site.config';

const questions = await Promise.all(
	(await getQuestions()).map(async (q) => ({ ...q, Content: (await render(q)).Content })),
);
---

<BaseLayout title="Q&A" description={`Reader questions about baseball, answered by ${SITE.author}.`}>
	<section class="section">
		<div class="container layout">
			<div>
				<p class="eyebrow">Ask the author</p>
				<h1>Questions &amp; Answers</h1>
				<p class="intro">
					Curious about a player, a story, or the books? Send {SITE.authorShort} a question — some of the best ones get
					answered right here.
				</p>

				{questions.length === 0 && <p class="muted">No questions answered yet. Be the first to ask!</p>}

				<ol class="answers">
					{questions.map(({ id, data, Content }) => (
						<li id={id} class="answer">
							<h2>
								<a href={`#${id}`}>{data.question}</a>
							</h2>
							<p class="asked muted">
								Asked by {data.askedBy} · <FormattedDate date={data.pubDate} />
							</p>
							<div class="prose">
								<Content />
							</div>
						</li>
					))}
				</ol>
			</div>

			<aside class="ask" id="ask">
				<h2>Ask a question</h2>
				<AskForm />
			</aside>
		</div>
	</section>
</BaseLayout>

<style>
	.layout {
		display: grid;
		gap: 3rem;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
		align-items: start;
	}

	.intro {
		font-size: 1.25rem;
		margin-bottom: 2.5rem;
	}

	.answers {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.answer {
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.answer h2 {
		font-size: 1.6rem;
		margin-bottom: 0.25rem;
	}

	.answer h2 a {
		color: inherit;
		text-decoration: none;
	}

	.answer h2 a::before {
		content: 'Q. ';
		color: var(--color-primary);
	}

	.asked {
		margin: 0 0 1rem;
		font-size: 0.95rem;
	}

	.ask {
		position: sticky;
		top: 1.5rem;
	}

	.ask h2 {
		font-size: 1.5rem;
	}

	@media (max-width: 56rem) {
		.layout {
			grid-template-columns: 1fr;
		}

		.ask {
			position: static;
		}
	}
</style>
