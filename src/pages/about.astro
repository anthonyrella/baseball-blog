---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = (await getEntry('pages', 'about'))!;
const { title, intro, photo } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={title} description={intro}>
	<section class="section">
		<div class="narrow">
			<p class="eyebrow">The author</p>
			<h1>{title}</h1>
			{intro && <p class="intro">{intro}</p>}
			{photo && <img class="photo" src={photo} alt={`Photo of ${title.replace(/^About\s+/, '')}`} />}
			<div class="prose">
				<Content />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		font-size: 1.3rem;
		color: var(--color-muted);
	}

	.photo {
		float: right;
		width: min(40%, 16rem);
		margin: 0 0 1.5rem 2rem;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	@media (max-width: 34rem) {
		.photo {
			float: none;
			width: 100%;
			margin: 0 0 1.5rem;
		}
	}
</style>
