---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/content';
import { CATEGORIES } from '../site.config';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	size?: 'default' | 'large';
}

const { post, size = 'default' } = Astro.props;
const { title, description, pubDate, category, heroImage, heroAlt, draft } = post.data;
---

<article class:list={['post-card card', size]}>
	<a class="media" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
		{heroImage ? (
			<img src={heroImage} alt={heroAlt ?? ''} loading="lazy" />
		) : (
			<span class="post-art" data-category={category}>
				<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3">
					<path d="M50 12 88 50 50 88 12 50Z" />
					<path d="M50 88 50 70" />
					<rect x="46" y="8" width="8" height="8" transform="rotate(45 50 12)" fill="currentColor" />
					<rect x="84" y="46" width="8" height="8" transform="rotate(45 88 50)" fill="currentColor" />
					<rect x="8" y="46" width="8" height="8" transform="rotate(45 12 50)" fill="currentColor" />
					<circle cx="50" cy="52" r="4" fill="currentColor" />
				</svg>
			</span>
		)}
	</a>
	<div class="body">
		<p class="eyebrow">
			<a href={`/blog/category/${category}/`}>{CATEGORIES[category].label}</a>
			{draft && <span class="draft">Draft</span>}
		</p>
		<h3>
			<a href={`/blog/${post.id}/`}>{title}</a>
		</h3>
		<p class="description">{description}</p>
		<p class="meta muted">
			<FormattedDate date={pubDate} /> · {readingTime(post.body)}
		</p>
	</div>
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.media {
		display: block;
	}

	.post-card img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	/* Vary the glow per category so a row of cards doesn't look identical. */
	.post-art[data-category='thoughts'] {
		background-position: 30% 0;
		filter: sepia(0.35);
	}

	.post-art[data-category='articles'] {
		transform: scaleX(-1);
	}

	.post-art[data-category='book-news'] {
		filter: brightness(1.15);
	}

	/* Large: image beside text, used for the featured story. */
	.large {
		flex-direction: row;
	}

	.large .media {
		flex: 1.3;
	}

	.large .media img,
	.large .post-art {
		height: 100%;
		aspect-ratio: auto;
		min-height: 20rem;
	}

	.large .body {
		flex: 1;
		justify-content: center;
		padding: 2.5rem;
	}

	@media (max-width: 48rem) {
		.large {
			flex-direction: column;
		}

		.large .post-art,
		.large .media img {
			min-height: 0;
			aspect-ratio: 16 / 9;
		}

		.large .body {
			padding: 1.5rem;
		}
	}

	.body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.4rem 1.5rem 1.25rem;
	}

	.eyebrow a {
		color: var(--color-label);
		text-decoration: none;
	}

	.draft {
		margin-left: 0.5rem;
		padding: 0.1em 0.5em;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-radius: 4px;
	}

	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--color-link-hover);
	}

	.description {
		margin: 0 0 1rem;
		flex: 1;
	}

	.meta {
		margin: 0;
		font-size: 0.9rem;
	}

	.large h3 {
		font-size: clamp(1.7rem, 3vw, 2.3rem);
	}

	.large .description {
		font-size: 1.15rem;
	}
</style>
