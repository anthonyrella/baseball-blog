---
import { CATEGORIES, NAV, SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container cols">
		<div class="about">
			<p class="name">{SITE.title}</p>
			<p>{SITE.description}</p>
		</div>
		<nav aria-label="Sections">
			<p class="heading">Sections</p>
			{NAV.map(({ href, label }) => (
				<a href={href}>{label}</a>
			))}
		</nav>
		<nav aria-label="Categories">
			<p class="heading">Writing</p>
			{Object.entries(CATEGORIES).map(([key, { label }]) => (
				<a href={`/blog/category/${key}/`}>{label}</a>
			))}
			<a href="/rss.xml">RSS feed</a>
		</nav>
	</div>
	<div class="container">
		<p class="copyright">
			&copy; {year} {SITE.author}. All rights reserved.
		</p>
	</div>
</footer>

<style>
	.cols {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2.5rem;
		padding-block: 3.5rem 2rem;
	}

	p {
		margin: 0;
	}

	.name {
		margin-bottom: 0.75rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.about p:not(.name) {
		max-width: 28rem;
		opacity: 0.8;
	}

	nav {
		display: grid;
		align-content: start;
		gap: 0.4rem;
	}

	.heading {
		margin-bottom: 0.4rem;
		font-family: var(--font-display);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	nav a {
		color: inherit;
		text-decoration: none;
		opacity: 0.85;
	}

	nav a:hover {
		color: var(--color-accent);
		opacity: 1;
	}

	.copyright {
		padding-block: 1.5rem 2rem;
		border-top: 1px solid rgb(255 248 231 / 15%);
		font-size: 0.9rem;
		opacity: 0.7;
	}

	@media (max-width: 48rem) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}

		.about {
			grid-column: 1 / -1;
		}
	}
</style>
