---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="container masthead">
		<p class="top-line">
			<span>Est. 2026</span>
			<span class="by">by {SITE.author}</span>
			<span>Stories of the Game</span>
		</p>
		<a class="brand" href="/">
			{SITE.title}
		</a>
		<div class="ornament" aria-hidden="true">
			<svg width="22" height="22" viewBox="0 0 22 22">
				<path d="M11 1 21 11 11 21 1 11Z" fill="currentColor" />
			</svg>
		</div>
		<nav aria-label="Main">
			<ul>
				<li>
					<a href="/" aria-current={path === '/' ? 'page' : undefined}>
						Home
					</a>
				</li>
				{NAV.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.masthead {
		padding-block: 1.25rem 0;
		text-align: center;
	}

	.top-line {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.brand {
		display: block;
		font-family: var(--font-brand);
		font-size: clamp(2.2rem, 7vw, 4.6rem);
		line-height: 1.05;
		color: var(--color-secondary);
		text-decoration: none;
		text-shadow: 2px 2px 0 var(--color-accent);
	}

	.ornament {
		margin-block: 0.6rem 0.3rem;
	}

	ul {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.25rem 2.25rem;
		list-style: none;
		margin: 0;
		padding: 0.6rem 0 0.7rem;
		border-bottom: 3px double var(--color-secondary);
	}

	nav a {
		color: var(--color-secondary);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--color-primary);
	}

	@media (max-width: 40rem) {
		.top-line span:not(.by) {
			display: none;
		}

		.top-line {
			justify-content: center;
		}

		ul {
			gap: 0.25rem 1.25rem;
		}
	}
</style>
