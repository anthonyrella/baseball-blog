---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
---

<div class="ticker">
	<div class="container">
		{SITE.tagline} · by {SITE.author}
	</div>
</div>
<header class="site-header">
	<div class="container bar">
		<a class="brand" href="/">
			<svg class="logo" viewBox="0 0 40 40" aria-hidden="true">
				<circle cx="20" cy="20" r="18" fill="#fff8e7" />
				<path
					d="M9 8c5 5 5 19 0 24M31 8c-5 5-5 19 0 24"
					fill="none"
					stroke="#c0392b"
					stroke-width="2"
					stroke-dasharray="3 2.5"
				/>
			</svg>
			<span>{SITE.title}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{NAV.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<a class="btn btn-accent ask" href="/questions/#ask">
			Ask {SITE.authorShort}
		</a>
	</div>
</header>

<style>
	.ticker {
		background: var(--color-primary);
		color: var(--color-secondary);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding-block: 0.35rem;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		padding-block: 1rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-right: auto;
		color: inherit;
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.logo {
		width: 2.4rem;
		height: 2.4rem;
		flex-shrink: 0;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		position: relative;
		color: inherit;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
	}

	nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.4rem;
		height: 3px;
		background: var(--color-accent);
		transform: scaleX(0);
		transition: transform 0.2s;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--color-accent);
	}

	nav a:hover::after,
	nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.ask {
		padding: 0.6em 1.1em;
		font-size: 0.85rem;
	}

	@media (max-width: 48rem) {
		.ask {
			display: none;
		}

		nav {
			width: 100%;
		}
	}
</style>
