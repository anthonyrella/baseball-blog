---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href="/">
			<span class="brand-name">{SITE.title}</span>
			<span class="brand-by">by {SITE.author}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{NAV.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		padding-block: 1.1rem;
	}

	.brand {
		display: grid;
		color: inherit;
		text-decoration: none;
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: 1.7rem;
		font-weight: 900;
		line-height: 1.1;
		color: var(--color-accent);
	}

	.brand-by {
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		opacity: 0.85;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		color: inherit;
		font-weight: 700;
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 2px solid transparent;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--color-accent);
		border-bottom-color: var(--color-accent);
	}
</style>
